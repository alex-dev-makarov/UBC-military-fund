# Frontend (Vite) environment. Everything here is PUBLIC — it is inlined into
# the client bundle at build time. Server secrets live in api/.env.

# Where the API lives, from the browser's point of view.
#
# It MUST be same-site with the SPA, or the session cookie is third-party and
# gets discarded — by Telegram's in-app browser among others. In development
# that means the relative path below, served by the Vite proxy. In production
# use https://api.<your-domain> together with COOKIE_DOMAIN=.<your-domain>,
# which is same-site; two unrelated hosts are not.
VITE_API_URL=/api

# Telegram bot username without the leading @. The login widget needs it, and
# BotFather /setdomain must point at the host serving this SPA — the widget
# refuses to render on localhost.
VITE_TELEGRAM_BOT=your_bot_username
