{
  "name": "api",
  "version": "0.0.1",
  "description": "NestJS backend API",
  "private": true,
  "type": "commonjs",
  "license": "MIT",
  "scripts": {
    "build": "nest build",
    "start": "node dist/main",
    "start:dev": "nest start --watch",
    "test": "vitest run",
    "smoke": "node scripts/smoke.mjs",
    "test:watch": "vitest",
    "test:smoke": "node scripts/smoke.mjs",
    "test:all": "pnpm build && pnpm test && pnpm test:smoke",
    "db:migrate": "node scripts/migrate.mjs",
    "db:seed": "node scripts/seed.mjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/jwt": "^12.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "cookie-parser": "^1.4.6",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.1",
    "undici": "^8.10.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@types/cookie-parser": "^1.4.7",
    "@types/express": "^5.0.0",
    "@types/node": "^24.13.3",
    "typescript": "^5.3.3",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=22.5.0"
  }
}
