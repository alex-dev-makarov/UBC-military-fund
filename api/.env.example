# Local backend (pnpm docker:up). Copy to api/.env.
# Everything not listed here is fixed in api/src/app/config/env.ts.
APP_ENV=local
PUBLIC_SITE_URL=http://localhost:5173

# openssl rand -base64 48
JWT_SECRET=

# Your own test bot (one bot = one running backend)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1002009243130
TELEGRAM_BOT_POLLING=true

# Your Telegram ID to test /add locally (send /id to the bot)
ADMIN_TELEGRAM_IDS=
