# Server port
PORT=3000

PUBLIC_SITE_URL=https://your-domain.example

FRONTEND_ORIGIN=https://your-frontend-tunnel.example

JWT_SECRET=
# Session lifetime: 15m / 2h / 7d. Also drives the cookie's Max-Age, so the two
# can never disagree. Short sessions mean re-authenticating often — that is the
# intent, since a session is the one thing that outlives a membership check.
JWT_EXPIRES_IN=15m

# Telegram integration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Authentication settings
AUTH_MAX_AGE_SEC=60

# Cookie configuration
COOKIE_NAME=ubc_session
COOKIE_SAMESITE=none
COOKIE_SECURE=true
COOKIE_DOMAIN=

# SQLite database file (relative to the API process CWD; ":memory:" for tests)
DATABASE_PATH=./data/ubc.sqlite

# Deep-link login (t.me/<bot>?start=<nonce>) — no phone-number prompt.
# Long polling must run in exactly ONE process: Telegram serves getUpdates to a
# single consumer, so a second poller silently steals half the updates.
TELEGRAM_BOT_POLLING=true
LOGIN_NONCE_TTL_SEC=300

# How long a membership verdict is cached. This is exactly the window in which
# a user removed from the channel can still read the private report.
# How long a membership verdict is cached. This is exactly the window in which
# someone who has just left the channel can still read the private report —
# measured at ~60s with the default. Set 0 to disable the cache entirely, so
# every read re-asks Telegram and revocation is immediate. 0 costs one Bot API
# call per request, which is negligible at this scale.
MEMBERSHIP_TTL_SEC=0
