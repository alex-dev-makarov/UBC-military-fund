# Prod server, the only env file there. Copy to deploy/prod.env, chmod 600.
COMPOSE_PROJECT_NAME=ubc-prod
API_ENV_FILE=./deploy/prod.env
DATA_DIR=./api/data-prod
CLOUDFLARE_TUNNEL_TOKEN=

APP_ENV=prod
PUBLIC_SITE_URL=https://ubc-military-fund.com
FRONTEND_ORIGIN=https://www.ubc-military-fund.com

# openssl rand -base64 48
JWT_SECRET=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=-1002009243130

# Telegram IDs of people who may add/edit expenses in the bot (get yours: /id in the bot)
ADMIN_TELEGRAM_IDS=

# Google (bot account), from: pnpm google:auth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_SHEET_ID=
GOOGLE_SHEET_GID=0
GOOGLE_RECEIPTS_FOLDER_ID=
GOOGLE_PHOTOS_FOLDER_ID=

