    "@vitejs/plugin-react": "^4.4.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
