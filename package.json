{
  "name": "ubc-military-fund",
  "private": true,
  "type": "module",
  "sideEffects": [
    "**/*.css"
  ],
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite --host",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --force",
    "deploy": "pnpm run build && wrangler deploy",
    "lint": "eslint .",
    "docker:up": "docker compose up -d --build --wait",
    "docker:down": "docker compose down",
    "docker:reset": "docker compose down && rm -f api/data/ubc.sqlite* && docker compose up -d --build --wait && docker compose exec -T api node scripts/seed.mjs",
    "docker:logs": "docker compose logs -f api",
    "docker:health": "curl -sS localhost:3000/health",
    "db": "node scripts/db.mjs",
    "db:migrate": "pnpm --filter api db:migrate",
    "db:seed": "pnpm --filter api db:seed"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-redux": "^9.2.0",
    "react-router": "^8.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.0",
    "@types/node": "^26.4.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "babel-plugin-react-compiler": "^19.1.0-rc.2",
    "tailwindcss": "^4.1.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "wrangler": "^4.0.0"
  }
}
